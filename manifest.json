{
    "manifest_version": 3,
    "name": "Create New Tab",
    "version": "0.1",
    "description": "Clone a new tab.",
    "author": "vinds",
    "permissions": ["activeTab", "scripting", "tabs"],
    "action": {
        "default_title": "enable"
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "clone-tab": {
            "suggested_key": {
                "default": "Alt+M"
            },
            "description": "Clone current tab"
        }
    }
}